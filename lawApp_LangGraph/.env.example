# 环境变量模板 —— 复制为同目录下的 .env 后填写
#     cp lawApp_LangGraph/.env.example lawApp_LangGraph/.env
#
# 优先级: 进程 env > 本文件 > config.py 默认值
# 其中绝大部分字段由 config.py 的 pydantic-settings 读取(清单见 docs/PROJECT_OVERVIEW.md §15);
# LEGAL_ANALYSIS_ROLE 由 prompts.py 直接读, HF_ENDPOINT 由 RAG_program.py 在进程启动期读

# ============ 必填: 无默认值, 不填则对应功能不可用 ============

# DeepSeek —— LLM 规划与执行
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Pinecone —— 案例混合检索(密集 + 稀疏)
PINECONE_API_KEY=

# SerpAPI —— 联网搜索工具
SERPAPI_API_KEY=

# ============ 必填: 有默认值, 但生产环境应当覆盖 ============

# PostgreSQL —— 长期记忆 / 法条检索 / checkpoint
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Law_app
DB_USER=postgres
DB_PASSWORD=postgres

# 也可用连接串直连, 设置后覆盖上面各项
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/Law_app

# ============ 可选: 模型与检索 ============

DEEPSEEK_PRO_MODEL=deepseek-reasoner
DEEPSEEK_FLASH_MODEL=deepseek-chat
PINECONE_INDEX_NAME=pinecone-test-lawapp
MEMORY_EMBED_MODEL=BAAI/bge-large-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-large
EMBED_DIM=1024
# "0" 禁用重排序
RERANK_ENABLED=1

# ============ 可选: 数据文件 ============
# 留空则用 config.py 按 __file__ 算出的 <repo>/data 下同名文件

# BM25_PATH=
# DOCUMENTS_DIR=

# ============ 可选: 图执行与评估 ============

RECURSION_LIMIT=60
MAX_ROUNDS=10
MAX_CLARIFY_ROUNDS=5
ERROR_STREAK_THRESHOLD=2

# CRAG 三档阈值
CORRECT_THRESHOLD=0.5
INCORRECT_THRESHOLD=0.2
MIN_QUALITY_DOCS=3

# ============ 可选: MCP ============

MCP_SERVER_URL=http://127.0.0.1:9381/mcp
MCP_HOST=127.0.0.1
MCP_PORT=9381
# "0" 关闭外部 MCP 工具挂载, 仅用本地工具
MCP_TOOLS_ENABLED=1

# ============ 可选: 日志 ============

LOG_DIR=./logs
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=INFO

# ============ 可选: 其他 ============

# 法律分析角色: kim(默认) / saul
LEGAL_ANALYSIS_ROLE=kim

# 持久化后端: auto / postgres / memory
CHECKPOINT_BACKEND=auto

# 进程启动期生效, 不走 config.py, 由 RAG_program.py 直接读取
# HF_ENDPOINT=https://hf-mirror.com
